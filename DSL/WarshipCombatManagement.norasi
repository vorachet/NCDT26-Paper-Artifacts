  chain Time_Critical_Radar_To_Track {
    realizes Time_Critical_Sensor_To_Track
    type MISSION
    detect_km = 25.0
    speed_km_s = 0.25

    step Fly_At_The_Ship
    step Detect_Air_Contacts
    step Ingest_Asterix_Plots
    step Fuse_IMM_PDAF_Track

    Fly_At_The_Ship -> Detect_Air_Contacts : Radar_Return {
      realizes Contact_Echo
    }
    Detect_Air_Contacts -> Ingest_Asterix_Plots : ASTERIX_CAT48_Plots {
      realizes Plot_Message
    }
    Ingest_Asterix_Plots -> Fuse_IMM_PDAF_Track : Radar_SensorReport {
      realizes Sensor_Report
    }

    mop K_TrackMan_Fusion_Cycle_At_1000_Tracks_s [0 .. 1.5] minimize {
      formula round(PN('Fuse_IMM_PDAF_Track','tracks') * PN('Fuse_IMM_PDAF_Track','ms_per_track') / 1000 / (PN('Fuse_IMM_PDAF_Track','fusion_nodes') * PN('Fuse_IMM_PDAF_Track','cores_used')), 2)
      rationale TIME. MOP for question PA, the datasheet line of K_TrackMan on Fusion_Processor: how long K-TrackMan takes to bring every track up to date once, at a thousand tracks -- within a revisit and a half, or the tracks fall behind. Red as written: one node, one core. Feeds Radar_And_K_TrackMan_Track_Initiation_s.
      accountable Tactical_Action_Officer
      responsible Ship_Technicians, Track_Supervisor
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop K_TrackMan_Track_Capacity [500 .. 2000] maximize {
      formula PN('Fuse_IMM_PDAF_Track','tracks')
      refines Track_Fusion_Capacity
      rationale QUALITY. MOP for question PA, the datasheet line of K_TrackMan on Fusion_Processor: how many tracks does K-TrackMan hold at once, as the CMS maker's software is built -- a thousand, at least 500? Its share of LA's Track_Fusion_Capacity.
      accountable Tactical_Action_Officer
      responsible Track_Supervisor
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Surveillance_Radar_Catalogue_Range_km [20 .. 100] maximize {
      formula PN('Surveillance_Radar_Unit','range_km')
      refines Sensor_Report_Range_km
      rationale TIME. MOP for question PA, the datasheet line of Surveillance_Radar_Unit: how far does the surveillance radar detect a small air target, as its maker's catalogue gives it -- at least 20 km? What a radar contract can promise. Its share of LA's Sensor_Report_Range_km.
      accountable Tactical_Action_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Radar_And_K_TrackMan_Track_Initiation_s [0 .. 4.5] minimize {
      formula round(PN('Ingest_Asterix_Plots','ingest_s') + PN('Fuse_IMM_PDAF_Track','confirm_scans') * max(PN('Detect_Air_Contacts','scan_s'), MOPV('K_TrackMan_Fusion_Cycle_At_1000_Tracks_s')), 1)
      rationale TIME. MOP for question PA, the datasheet line of Radar_Adapter on Sensor_Interface_Unit, K_TrackMan on Fusion_Processor, Surveillance_Radar_Firmware on Surveillance_Radar_Unit: from the first plot to a firm track, the decode included: 3 revisits, each as long as the radar's revisit or the fusion cycle, whichever is slower. Red as written: each is the 2.6 s fusion cycle, not the radar's 1 s revisit. Feeds Fusion_Processor_Detect_To_Advice_Time_s.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator, Track_Supervisor
      consulted Ship_Technicians when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Failure_COP_Node_To_Hot_Standby {
    realizes Failure_Node_Loss_To_Takeover
    type MISSION

    step Monitor_Node_Heartbeats
    step Elect_Picture_Authority

    Monitor_Node_Heartbeats -> Elect_Picture_Authority : NodeStatus_Missed {
      realizes Node_Lost
    }

    mop COP_Hot_Standby_Takeover_Time_s [0 .. 2] minimize {
      formula PN('Elect_Picture_Authority','failover_s')
      rationale TIME. MOP for question PA, the datasheet line of Multi_Node_COP on COP_Servers: how long the hot standby takes to hold the picture.
      accountable Tactical_Action_Officer
      responsible Ship_Technicians, Track_Supervisor
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop COP_Hot_Standby_Added_Delay_s [0 .. 0.1] minimize {
      formula round(PN('Elect_Picture_Authority','fail_share') * PN('Elect_Picture_Authority','failover_s'), 2)
      rationale TIME. MOP for question PA, the datasheet line of Multi_Node_COP on COP_Servers: what a lost picture node adds to every reaction, on average. Feeds Fusion_Processor_Detect_To_Advice_Time_s.
      accountable Commanding_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Watch_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Mission_HITL_Engagement {
    realizes Mission_Logical_Engagement
    type MISSION

    step Rank_Threats
    step Show_Engage_Advice
    step Order_Engage
    step Hold_Engagement_For_Weapons_Free
    step Order_Weapons_Free
    step Release_On_Weapons_Free
    step Designate_Fire_Control_Director
    step Lock_And_Track_Target
    step Compute_Ballistic_Solution
    step Release_Gun_Through_Interlock
    step Lay_And_Fire

    Rank_Threats -> Show_Engage_Advice : Threat_List_Topic {
      realizes Threat_Ranking
    }
    Show_Engage_Advice -> Order_Engage : TEWA_Advice_On_Screen {
      realizes Engage_Advice
    }
    Order_Engage -> Hold_Engagement_For_Weapons_Free : E_Keypress {
      realizes Engage_Order
    }
    Hold_Engagement_For_Weapons_Free -> Order_Weapons_Free : F_Prompt {
      realizes Weapons_Free_Request
    }
    Order_Weapons_Free -> Release_On_Weapons_Free : F_Keypress {
      realizes Weapons_Free_Order
    }
    Release_On_Weapons_Free -> Designate_Fire_Control_Director : Engagement_Released_Topic {
      realizes Released_Engagement
    }
    Designate_Fire_Control_Director -> Lock_And_Track_Target : STIR_Designation {
      realizes Target_Designation
    }
    Lock_And_Track_Target -> Compute_Ballistic_Solution : STIR_Track_Feed {
      realizes Fire_Control_Track
    }
    Compute_Ballistic_Solution -> Release_Gun_Through_Interlock : Ballistic_Solution {
      realizes Fire_Solution
    }
    Release_Gun_Through_Interlock -> Lay_And_Fire : WIM_GunOrder {
      realizes Fire_Order
    }

    mop Fusion_Processor_Detect_To_Advice_Time_s [0 .. 8] minimize {
      formula round(MOPV('Radar_And_K_TrackMan_Track_Initiation_s') + PN('Fuse_Identity_Evidence','id_s') + PN('Rank_Threats','tewa_s') + PN('Show_Engage_Advice','display_s') + MOPV('COP_Hot_Standby_Added_Delay_s'), 1)
      refines Track_To_Engage_Advice_Processing_Time_s
      rationale TIME. MOP for question PA, the datasheet line of K_QCF on Fusion_Processor, K_TEWA on Combat_Processor, Q7_Tactical_Display on CIC_Consoles: does the system as fitted give the officers the engagement advice within 8 s of a threat's first plot, in a busy strait? Red as written: a track takes 8.1 s to firm up on one fusion processor. Its share of LA's Track_To_Engage_Advice_Processing_Time_s.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer, Fire_Control_Operator
      consulted Training_Officer when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }

    mop FCS_Core_Order_To_First_Round_Time_s [0 .. 30] minimize {
      formula PN('Order_Engage','decision_s') + PN('Order_Weapons_Free','decision_s') + PN('Designate_Fire_Control_Director','designation_s') + PN('Lock_And_Track_Target','lock_s') + PN('Compute_Ballistic_Solution','solution_s') + PN('Lay_And_Fire','lay_s')
      rationale TIME. MOP for question PA, the datasheet line of FCS_Core on Fire_Control_Processor, Fire_Control_Radar_Firmware on Fire_Control_Radar_Unit, Gun_Mount_Control on Main_Gun_76mm: from the advice to the first round, E and F included.
      accountable Tactical_Action_Officer
      responsible Fire_Control_Operator, Gun_Crew, Close_In_Weapon_Crew
      consulted Training_Officer when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Problem_Equipment_Down_Awaiting_Spare {
    realizes Problem_Logical_Equipment_Down
    type MISSION

    step Run_Built_In_Test
    step Send_Spare
    step Repair_Equipment
    step Confirm_Repair

    Run_Built_In_Test -> Send_Spare : Defect_Record_Out {
      realizes Defect_Report
    }
    Send_Spare -> Repair_Equipment : Spare_Part_Shipped {
      realizes Spare_Part
    }
    Repair_Equipment -> Confirm_Repair : Repair_Logged {
      realizes Repair_Done
    }

    mop Fitted_System_Availability_At_Sea_Pct [99 .. 100] maximize {
      formula round(100 / (1 / PN('Run_Built_In_Test','other_mtbf_h') + (PN('Fuse_IMM_PDAF_Track','fusion_nodes') < 2) / PN('Run_Built_In_Test','fusion_mtbf_h')) / (1 / (1 / PN('Run_Built_In_Test','other_mtbf_h') + (PN('Fuse_IMM_PDAF_Track','fusion_nodes') < 2) / PN('Run_Built_In_Test','fusion_mtbf_h')) + PN('Repair_Equipment','mttr_h') + PN('Send_Spare','logistics_h')), 2)
      refines Logical_Arrangement_Availability_Pct
      rationale QUALITY. MOP for question PA, the datasheet line of K_BIT on BIT_Server, K_TrackMan on Fusion_Processor: is the system as fitted ready at least 99 % of the time at sea? Red as written: the one fusion processor fails every 4,000 hours and nothing stands in while its spare is 48 hours away. Its share of LA's Logical_Arrangement_Availability_Pct.
      accountable Commanding_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Fleet_Command when MONTHLY by REPORT
    }
  }

  chain Opportunity_Link_16_Early_Cue {
    realizes Opportunity_Logical_Link_Cue
    type MISSION

    step Share_A_Track
    step Transmit_And_Receive_Link
    step Receive_J_Series_Track
    step Send_Search_Cue

    Share_A_Track -> Transmit_And_Receive_Link : Link_16_RF_In {
      realizes Allied_Track_Message
      latency_s = 6.0
    }
    Transmit_And_Receive_Link -> Receive_J_Series_Track : J_Series_Track_In
    Receive_J_Series_Track -> Send_Search_Cue : Search_Cue_Topic {
      realizes Allied_Cue
    }

    mop Link_16_Early_Warning_Time_s [60 .. 300] maximize {
      formula round((PN('Receive_J_Series_Track','link_track_km') - PN('Time_Critical_Radar_To_Track','detect_km')) / PN('Time_Critical_Radar_To_Track','speed_km_s') - PN('Link_16_RF_In','latency_s') - MOPV('K_TrackMan_Fusion_Cycle_At_1000_Tracks_s'), 1)
      rationale TIME. MOP for question PA, the datasheet line of KTDL_Gateway on Gateway_Processor: the seconds of warning a Link 16 track gives the officers before the ship's own radar sees the threat: 6 s old on arrival, and on the picture when K-TrackMan next completes a fusion cycle. The options that speed the cycle move it, by under 2 s; none buys anything on the link.
      accountable Tactical_Action_Officer
      responsible Track_Supervisor, Allied_Unit
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Watch_Officer when ON_CHANGE by DASHBOARD
    }
  }

  chain Cost_Critical_Q7_Ownership {
    realizes Cost_Critical_Logical_Ownership
    type MISSION

    step Plan_Support
    step Maintain_Equipment
    step Report_Q7ERP_Readiness
    step Replay_Exercise

    Plan_Support -> Maintain_Equipment : Support_Plan_Issued {
      realizes Support_Plan
    }
    Maintain_Equipment -> Report_Q7ERP_Readiness : Servicing_Logged {
      realizes Maintenance_Record
    }
    Report_Q7ERP_Readiness -> Replay_Exercise : BIT_Pass {
      realizes Readiness_Confirmed
    }

    mop Q7_Support_Hardware_Spares_Cost_MTHB_Year [0 .. 28] minimize {
      formula PN('Report_Q7ERP_Readiness','support_mthb') + PN('Report_Q7ERP_Readiness','hardware_mthb') + PN('Report_Q7ERP_Readiness','spares_mthb')
      rationale COST. MOP for question PA, the datasheet line of K_BIT on BIT_Server: the software support, the hardware and the spares, a year. Feeds Q7_Ownership_Cost_MTHB_Year.
      accountable Fleet_Support
      responsible Ship_Technicians
      consulted Commanding_Officer when BEFORE_CHANGE by REPORT
      informed Fleet_Command when MONTHLY by REPORT
    }

    mop Q7_Ownership_Cost_MTHB_Year [0 .. 32] minimize {
      formula round(MOPV('Q7_Support_Hardware_Spares_Cost_MTHB_Year') + PN('Replay_Exercise','training_mthb'), 2)
      refines Logical_Ownership_Cost_MTHB_Year
      rationale COST. MOP for question PA, the datasheet line of K_Recorder on Recorder_Server: does the system as fitted cost the navy no more than 32 MTHB a year to keep, any change bought included? Green as written, with 4 MTHB to spare. Its share of LA's Logical_Ownership_Cost_MTHB_Year.
      accountable Fleet_Support
      responsible Ship_Technicians
      consulted Commanding_Officer when BEFORE_CHANGE by MEETING
      informed Fleet_Command when MONTHLY by REPORT
    }
  }

  chain Quality_Critical_Identity_Fusion {
    realizes Quality_Critical_Logical_Air_Picture
    type MISSION

    step Broadcast_Identity
    step Receive_AIS_Message
    step Decode_AIS_AIVDM
    step Fuse_Identity_Evidence
    step Classify_EO_Target
    step Show_Proposed_Identity
    step Confirm_Identity

    Broadcast_Identity -> Receive_AIS_Message : AIS_VHF_Message {
      realizes Identity_Broadcast
    }
    Receive_AIS_Message -> Decode_AIS_AIVDM : NMEA_AIVDM_Sentence
    Decode_AIS_AIVDM -> Fuse_Identity_Evidence : AIS_SensorReport {
      realizes Identity_Reports
    }
    Fuse_Identity_Evidence -> Classify_EO_Target : Unresolved_Track_Cue {
      realizes Unresolved_Track
    }
    Classify_EO_Target -> Show_Proposed_Identity : ATR_Identity_Proposal {
      realizes Proposed_Identity
    }
    Show_Proposed_Identity -> Confirm_Identity : Identity_Symbol_On_Screen {
      realizes Identity_On_Screen
    }

    mop K_TrackMan_Identified_Track_Share_Pct [95 .. 100] maximize {
      formula round(100 * PN('Fuse_IMM_PDAF_Track','held_share') * (PN('Fuse_Identity_Evidence','coop_share') * PN('Fuse_Identity_Evidence','coop_accuracy') + (1 - PN('Fuse_Identity_Evidence','coop_share')) * PN('Classify_EO_Target','noncoop_accuracy')) * min(1, PN('Fuse_IMM_PDAF_Track','current_s') / max(PN('Detect_Air_Contacts','scan_s'), MOPV('K_TrackMan_Fusion_Cycle_At_1000_Tracks_s'))), 1)
      refines Fused_Identified_Track_Share_Pct
      rationale QUALITY. MOP for question PA, the datasheet line of K_TrackMan on Fusion_Processor, K_QCF on Fusion_Processor, ATR on Fusion_Processor, Surveillance_Radar_Firmware on Surveillance_Radar_Unit: are at least 95 % of the contacts around the ship held as current, correctly identified tracks by the system as fitted? Red as written: a fusion cycle of 2.6 s leaves every track older than the 2 s it must be. Its share of LA's Fused_Identified_Track_Share_Pct.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator, Track_Supervisor
      consulted Allied_Unit when BEFORE_CHANGE by REPORT
      informed Watch_Officer when ON_CHANGE by DASHBOARD
    }
  }

  decision Fusion_Processor {
    option Second_Fusion_Processor {
      Fuse_IMM_PDAF_Track.fusion_nodes = 2
      Report_Q7ERP_Readiness.hardware_mthb = 14.0
      Fusion_Processor.quantity = 2
    }

    option Faster_Fusion_Processor {
      Fuse_IMM_PDAF_Track.ms_per_track = 1.3
      Report_Q7ERP_Readiness.hardware_mthb = 13.5
      Fusion_Processor.local_share = 0
      Fusion_Processor.unit_cost = 9000000
    }

    option Faster_Processor_And_Spares {
      Fusion_Processor.local_share = 0.35
      Fusion_Processor.unit_cost = 8000000
      Fuse_IMM_PDAF_Track.ms_per_track = 1.3
      Report_Q7ERP_Readiness.hardware_mthb = 13.5
      Send_Spare.logistics_h = 6.0
      Report_Q7ERP_Readiness.spares_mthb = 4.5
    }
  }

  decision K_TrackMan {
    option Multicore_Rework {
      Fuse_IMM_PDAF_Track.cores_used = 4
      Report_Q7ERP_Readiness.support_mthb = 12.0
    }

    option Thin_The_Picture {
      Fuse_IMM_PDAF_Track.tracks = 600
      Fuse_IMM_PDAF_Track.held_share = 0.8
    }
  }

  decision Surveillance_Radar_Unit {
    option Longer_Range_Radar {
      Surveillance_Radar_Unit.range_km = 80
      Surveillance_Radar_Unit.unit_cost = 320000000
    }
  }

  decision Fleet_Support {
    option Spares_On_Board {
      Send_Spare.logistics_h = 6.0
      Report_Q7ERP_Readiness.spares_mthb = 4.5
    }
  }
}
