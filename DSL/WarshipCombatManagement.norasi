  communication Air_Surveillance -> Track_Management {
    interface Scan_Period_Feed {
      data Scan_Period_Record
    }
  }

  chain Time_Critical_Sensor_To_Track {
    realizes Time_Critical_Plot_To_Track
    type MISSION
    detect_km = 25.0
    speed_km_s = 0.25

    step Fly_At_The_Ship
    step Detect_Air_Contacts
    step Ingest_Sensor_Reports
    step Fuse_Tracks

    Fly_At_The_Ship -> Detect_Air_Contacts : Contact_Echo
    Detect_Air_Contacts -> Ingest_Sensor_Reports : Plot_Message
    Ingest_Sensor_Reports -> Fuse_Tracks : Sensor_Report

    mop Track_Fusion_Initiation_Time_s [0 .. 4] minimize {
      formula round(TECH('Fuse_Tracks'), 1)
      rationale TIME. MOP for question LA, the logical component Track_Management: from the first plot to a firm track, the ingest included. Feeds Track_To_Engage_Advice_Processing_Time_s.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator, Track_Supervisor
      consulted Ship_Technicians when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Sensor_Report_Range_km [20 .. 100] maximize {
      formula PN('Time_Critical_Sensor_To_Track','detect_km')
      refines Small_Air_Target_Detection_Range_km
      rationale TIME. MOP for question LA, the logical arrangement: how far out do the logical sensors first report a threat to the track fusion -- at least 20 km? Its share of SA's Small_Air_Target_Detection_Range_km.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator
      consulted Ship_Technicians when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Track_Fusion_Capacity [500 .. 2000] maximize {
      formula PN('Fuse_Tracks','track_capacity')
      refines Simultaneous_Track_Capacity
      rationale QUALITY. MOP for question LA, the logical component Track_Management: how many tracks does the track fusion hold at once -- at least 500? Its share of SA's Simultaneous_Track_Capacity.
      accountable Tactical_Action_Officer
      responsible Track_Supervisor
      consulted Ship_Technicians when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Failure_Node_Loss_To_Takeover {
    realizes Failure_Picture_Loss_To_Recovery
    type MISSION

    step Watch_Node_Health
    step Take_Over_Picture

    Watch_Node_Health -> Take_Over_Picture : Node_Lost

    mop Standby_Picture_Takeover_Time_s [0 .. 2] minimize {
      formula TECH('Take_Over_Picture')
      refines Air_Picture_Recovery_Time_s
      rationale TIME. MOP for question LA, the logical component Picture_Resilience: how long the standby takes to hold the picture. Its share of SA's Air_Picture_Recovery_Time_s.
      accountable Tactical_Action_Officer
      responsible Ship_Technicians, Track_Supervisor
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Picture_Takeover_Added_Delay_s [0 .. 0.1] minimize {
      formula round(PN('Take_Over_Picture','fail_share') * TECH('Take_Over_Picture'), 2)
      rationale TIME. MOP for question LA, the logical component Picture_Resilience: what a lost node adds to every reaction, on average. Feeds Track_To_Engage_Advice_Processing_Time_s.
      accountable Commanding_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Watch_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Mission_Logical_Engagement {
    realizes Mission_Air_Defence_Engagement
    type MISSION

    step Rank_Threats
    step Show_Engage_Advice
    step Order_Engage
    step Hold_For_Weapons_Free
    step Order_Weapons_Free
    step Release_Engagement
    step Designate_Fire_Control_Sensor
    step Lock_And_Track_Target
    step Compute_Ballistics
    step Release_Through_Interlock
    step Aim_And_Fire

    Rank_Threats -> Show_Engage_Advice : Threat_Ranking {
      realizes Threat_Ranking
    }
    Show_Engage_Advice -> Order_Engage : Engage_Advice {
      realizes Engage_Advice
    }
    Order_Engage -> Hold_For_Weapons_Free : Engage_Order {
      realizes Engage_Order
    }
    Hold_For_Weapons_Free -> Order_Weapons_Free : Weapons_Free_Request {
      realizes Weapons_Free_Request
    }
    Order_Weapons_Free -> Release_Engagement : Weapons_Free_Order {
      realizes Weapons_Free_Order
    }
    Release_Engagement -> Designate_Fire_Control_Sensor : Released_Engagement
    Designate_Fire_Control_Sensor -> Lock_And_Track_Target : Target_Designation
    Lock_And_Track_Target -> Compute_Ballistics : Fire_Control_Track {
      realizes Fire_Control_Track
    }
    Compute_Ballistics -> Release_Through_Interlock : Fire_Solution
    Release_Through_Interlock -> Aim_And_Fire : Fire_Order {
      realizes Fire_Order
    }

    mop Track_To_Engage_Advice_Processing_Time_s [0 .. 9] minimize {
      formula round(MOPV('Track_Fusion_Initiation_Time_s') + PN('Fuse_Identity','id_s') + TECH('Rank_Threats') + TECH('Show_Engage_Advice') + MOPV('Picture_Takeover_Added_Delay_s'), 1)
      refines Detect_To_Engage_Advice_Time_s
      rationale TIME. MOP for question LA, the logical components Identification, Threat_Evaluation, Tactical_Display: does the arrangement give the officers the engagement advice within 9 s of a threat's first plot? Its share of SA's Detect_To_Engage_Advice_Time_s.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer, Fire_Control_Operator
      consulted Training_Officer when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }

    mop Fire_Control_Order_To_Round_Time_s [0 .. 30] minimize {
      formula PN('Order_Engage','decision_s') + PN('Order_Weapons_Free','decision_s') + TECH('Designate_Fire_Control_Sensor') + TECH('Lock_And_Track_Target') + TECH('Compute_Ballistics') + TECH('Aim_And_Fire')
      refines Engage_Order_To_First_Round_Time_s
      rationale TIME. MOP for question LA, the logical components Fire_Control, Fire_Control_Sensing, Weapon_Control: from the advice to the first round, through the gate. Its share of SA's Engage_Order_To_First_Round_Time_s.
      accountable Tactical_Action_Officer
      responsible Fire_Control_Operator, Gun_Crew, Close_In_Weapon_Crew
      consulted Training_Officer when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Problem_Logical_Equipment_Down {
    realizes Problem_Equipment_Down
    type MISSION

    step Detect_Defects
    step Send_Spare
    step Repair_Equipment
    step Confirm_Repair

    Detect_Defects -> Send_Spare : Defect_Report
    Send_Spare -> Repair_Equipment : Spare_Part
    Repair_Equipment -> Confirm_Repair : Repair_Done

    mop Logical_Arrangement_Availability_Pct [98.5 .. 100] maximize {
      formula round(100 / (1 / PN('Detect_Defects','other_mtbf_h') + (PN('Fuse_Tracks','fusion_nodes') < 2) / PN('Detect_Defects','fusion_mtbf_h')) / (1 / (1 / PN('Detect_Defects','other_mtbf_h') + (PN('Fuse_Tracks','fusion_nodes') < 2) / PN('Detect_Defects','fusion_mtbf_h')) + PN('Repair_Equipment','mttr_h') + PN('Send_Spare','logistics_h')), 2)
      refines Operational_Availability_At_Sea_Pct
      rationale QUALITY. MOP for question LA, the logical components Built_In_Test, Track_Management: is the arrangement ready at least 98.5 % of the time at sea? A fusion node fails every 4,000 hours, but with a partner the picture goes on. Its share of SA's Operational_Availability_At_Sea_Pct.
      accountable Commanding_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Fleet_Command when MONTHLY by REPORT
    }
  }

  chain Opportunity_Logical_Link_Cue {
    realizes Opportunity_Data_Link_Cue
    type MISSION

    step Share_A_Track
    step Exchange_Allied_Tracks
    step Cue_Sensors

    Share_A_Track -> Exchange_Allied_Tracks : Allied_Track_Message {
      realizes Allied_Track_Message
      latency_s = 6.0
    }
    Exchange_Allied_Tracks -> Cue_Sensors : Allied_Cue

    mop Allied_Track_Exchange_Warning_Time_s [60 .. 300] maximize {
      formula round((TECH('Exchange_Allied_Tracks') - PN('Time_Critical_Sensor_To_Track','detect_km')) / PN('Time_Critical_Sensor_To_Track','speed_km_s') - PN('Allied_Track_Message','latency_s') - PN('Fuse_Tracks','cycle_s'), 1)
      refines Data_Link_Early_Warning_Time_s
      rationale TIME. MOP for question LA, the logical components External_Links, Track_Management: the seconds of warning an allied track gives the officers before the ship's own sensors see the threat: 6 s old on arrival, and on the picture at its next update. Its share of SA's Data_Link_Early_Warning_Time_s.
      accountable Tactical_Action_Officer
      responsible Track_Supervisor, Allied_Unit
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Watch_Officer when ON_CHANGE by DASHBOARD
    }
  }

  chain Cost_Critical_Logical_Ownership {
    realizes Cost_Critical_Ownership
    type MISSION

    step Plan_Support
    step Maintain_Equipment
    step Report_Readiness
    step Record_And_Replay

    Plan_Support -> Maintain_Equipment : Support_Plan
    Maintain_Equipment -> Report_Readiness : Maintenance_Record
    Report_Readiness -> Record_And_Replay : Readiness_Confirmed

    mop Logical_Support_Hardware_Spares_Cost_MTHB_Year [0 .. 24] minimize {
      formula TECH('Report_Readiness')
      rationale COST. MOP for question LA, the logical component Built_In_Test: the software support, the hardware and the spares, a year. Feeds Logical_Ownership_Cost_MTHB_Year.
      accountable Fleet_Support
      responsible Ship_Technicians
      consulted Commanding_Officer when BEFORE_CHANGE by REPORT
      informed Fleet_Command when MONTHLY by REPORT
    }

    mop Logical_Ownership_Cost_MTHB_Year [0 .. 33] minimize {
      formula round(MOPV('Logical_Support_Hardware_Spares_Cost_MTHB_Year') + TECH('Record_And_Replay'), 2)
      refines Ownership_Cost_MTHB_Year
      rationale COST. MOP for question LA, the logical component Recording_And_Replay: does the arrangement cost no more than 33 MTHB a year to keep, leaving 2 for whatever PA must add? Its share of SA's Ownership_Cost_MTHB_Year.
      accountable Fleet_Support
      responsible Ship_Technicians
      consulted Commanding_Officer when BEFORE_CHANGE by MEETING
      informed Fleet_Command when MONTHLY by REPORT
    }
  }

  chain Quality_Critical_Logical_Air_Picture {
    realizes Quality_Critical_Air_Picture_Truth
    type MISSION

    step Broadcast_Identity
    step Receive_Identity_Messages
    step Fuse_Identity
    step Classify_Non_Cooperative
    step Show_Proposed_Identity
    step Confirm_Identity

    Broadcast_Identity -> Receive_Identity_Messages : Identity_Broadcast {
      realizes Identity_Broadcast
    }
    Receive_Identity_Messages -> Fuse_Identity : Identity_Reports {
      realizes Identity_Reports
    }
    Fuse_Identity -> Classify_Non_Cooperative : Unresolved_Track
    Classify_Non_Cooperative -> Show_Proposed_Identity : Proposed_Identity {
      realizes Proposed_Identity
    }
    Show_Proposed_Identity -> Confirm_Identity : Identity_On_Screen

    mop Fused_Identified_Track_Share_Pct [93 .. 100] maximize {
      formula round(100 * PN('Fuse_Tracks','held_share') * (TECH('Fuse_Identity') + (1 - PN('Fuse_Identity','coop_share')) * TECH('Classify_Non_Cooperative')) * min(1, PN('Fuse_Tracks','current_s') / max(TECH('Detect_Air_Contacts'), PN('Fuse_Tracks','cycle_s'))), 1)
      refines Contacts_Held_True_And_Identified_Pct
      rationale QUALITY. MOP for question LA, the logical components Track_Management, Identification, Air_Surveillance: are at least 93 % of the contacts around the ship held as current, correctly identified tracks? Its share of SA's Contacts_Held_True_And_Identified_Pct.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator, Track_Supervisor
      consulted Allied_Unit when BEFORE_CHANGE by REPORT
      informed Watch_Officer when ON_CHANGE by DASHBOARD
    }
  }

  decision Track_Management {
    option Single_Fusion_Node {
      Fuse_Tracks.fusion_nodes = 1
    }
  }
}

layer PA {

  system {
    node Physical_Nodes {
