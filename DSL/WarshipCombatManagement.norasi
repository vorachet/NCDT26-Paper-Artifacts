model WarshipCombatManagement

scale Raid_Outcome {
  SHIP_HIT LEAKER_INSIDE_2_KM DEFEATED_INSIDE_5_KM DEFEATED_BEYOND_5_KM
}

scale Threat_Presence {
  HOSTILE_INSIDE HOSTILE_OUTSIDE_ONLY CLEAR_FOR_6_H
}

scale Ship_Protection {
  SHIP_LOST SHIP_HIT UNPROTECTED_HOURS NONE_HIT
}

scale Engagement_Errors {
  CIVIL_OR_FRIEND_ENGAGED WRONG_TRACK_ORDERED NO_ERROR
}

scale Picture_State {
  PICTURE_LOST_IN_RAID LOST_OUTSIDE_RAID NEVER_LOST
}

scale Warning {
  SURPRISED OWN_SENSORS_FIRST ALLIES_FIRST
}

scale Raid_Readiness {
  NOT_READY READY_WITHIN_A_DAY READY_NOW
}

layer OA {

  entity Air_Threat non_human {
    domain AIR
    side HOSTILE
    icon cruise-missile
    allocates Fly_At_The_Ship
  }

  entity Civil_Traffic non_human {
    domain AIR
    side NEUTRAL
    icon airliner
    allocates Broadcast_Identity
  }

  entity Allied_Unit non_human {
    domain SURFACE
    side FRIEND
    icon frigate
    allocates Share_A_Track
  }

  entity Fleet_Command non_human {
    domain SURFACE
    side FRIEND
    icon headquarters
    allocates Pass_The_Fleet_Picture
  }

  entity Fleet_Support non_human {
    domain SURFACE
    side FRIEND
    icon warehouse
    allocates Send_The_Spare, Plan_The_Support
  }

  entity Air_Picture_Operator human {
    domain SURFACE
    side FRIEND
    icon radar-emitter
    allocates Watch_The_Air, Take_The_Early_Warning
  }

  entity Track_Supervisor human {
    domain SURFACE
    side FRIEND
    icon database
    allocates Plot_The_Track, Identify_The_Contact, Lose_The_Plot
  }

  entity Watch_Officer human {
    domain SURFACE
    side FRIEND
    icon operations-centre
    allocates Restore_The_Plot
  }

  entity Tactical_Action_Officer human {
    domain SURFACE
    side FRIEND
    icon warning
    allocates Evaluate_The_Threat, Order_Engage, Confirm_The_Identity
  }

  entity Commanding_Officer human {
    domain SURFACE
    side FRIEND
    icon commander
    allocates Order_Weapons_Free
  }

  entity Fire_Control_Operator human {
    domain SURFACE
    side FRIEND
    icon target
    allocates Acquire_The_Target
  }

  entity Gun_Crew non_human {
    domain SURFACE
    side FRIEND
    icon explosion
    allocates Fire_The_Gun
  }

  entity Close_In_Weapon_Crew non_human {
    domain SURFACE
    side FRIEND
    icon interceptor
    allocates Fire_Close_In
  }

  entity Ship_Technicians non_human {
    domain SURFACE
    side FRIEND
    icon engineer
    allocates Report_A_Defect, Repair_At_Sea, Maintain_The_Equipment
  }

  entity Training_Officer human {
    domain SURFACE
    side FRIEND
    icon person
    allocates Train_The_Watch
  }

  activity Fly_At_The_Ship

  activity Watch_The_Air

  activity Plot_The_Track

  activity Lose_The_Plot

  activity Restore_The_Plot

  activity Evaluate_The_Threat

  activity Order_Engage

  activity Order_Weapons_Free

  activity Acquire_The_Target

  activity Fire_The_Gun

  activity Fire_Close_In

  activity Report_A_Defect

  activity Send_The_Spare

  activity Repair_At_Sea

  activity Share_A_Track

  activity Take_The_Early_Warning

  activity Pass_The_Fleet_Picture

  activity Plan_The_Support

  activity Maintain_The_Equipment

  activity Train_The_Watch

  activity Broadcast_Identity

  activity Identify_The_Contact

  activity Confirm_The_Identity

  Plot_The_Track -> Evaluate_The_Threat : Track_On_The_Plot
  Plot_The_Track -> Identify_The_Contact : Contact_To_Identify
  Confirm_The_Identity -> Evaluate_The_Threat : Accepted_Identity
  Restore_The_Plot -> Evaluate_The_Threat : Rebuilt_Plot
  Take_The_Early_Warning -> Watch_The_Air : Look_There
  Pass_The_Fleet_Picture -> Plot_The_Track : Fleet_Picture
  Fire_The_Gun -> Fly_At_The_Ship : Rounds_At_The_Threat
  Fire_The_Gun -> Fire_Close_In : Threat_Still_Coming
  Fire_Close_In -> Fly_At_The_Ship : Last_Ditch_Fire

  chain Mission_Defended_Area_Clear_Of_Air_Threat_For_6_Hours {
    type MISSION
    step Fly_At_The_Ship
    step Watch_The_Air
    step Plot_The_Track

    Fly_At_The_Ship -> Watch_The_Air : Echo_On_The_Screen
    Watch_The_Air -> Plot_The_Track : Contact_Report

    moe Air_Threat_Gone_From_The_Defended_Area [CLEAR_FOR_6_H .. CLEAR_FOR_6_H] maximize {
      scale Threat_Presence
      today HOSTILE_OUTSIDE_ONLY
      formula LEVEL('Small_Air_Target_Detection_Range_km')
      rationale MISSION. MoE for question OA: in the operating area -- the open sea, 150 contacts around the ship, and the busy strait, 1,000 contacts and raids of 30 minutes -- with the CMS deployed, how effectively does the ship watch the air and plot every contact, so the command can say the air threat is gone -- no hostile air contact inside the defended area for 6 hours? It needs from the system Small_Air_Target_Detection_Range_km [20 .. 100], Simultaneous_Track_Capacity [500 .. 2000] -- what the market offers as a 3D air surveillance radar and a track management system. Today: HOSTILE_OUTSIDE_ONLY -- the ship holds the threat outside, and cannot yet say it has gone.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }
  }

  chain Mission_Air_Picture_Never_Lost_During_A_Raid {
    type MISSION
    step Lose_The_Plot
    step Restore_The_Plot

    Lose_The_Plot -> Restore_The_Plot : Plot_Gone

    moe Air_Picture_Held_Through_A_Raid [NEVER_LOST .. NEVER_LOST] maximize {
      scale Picture_State
      today LOST_OUTSIDE_RAID
      formula LEVEL('Air_Picture_Recovery_Time_s')
      rationale MISSION. MoE for question OA: in the operating area -- the open sea, 150 contacts around the ship, and the busy strait, 1,000 contacts and raids of 30 minutes -- with the CMS deployed, how effectively is the air picture kept when a plot node is lost -- never lost while a raid is inside? It needs from the system Air_Picture_Recovery_Time_s [0 .. 3] -- what the market offers as a redundant combat-system server cluster with a hot standby. Today: LOST_OUTSIDE_RAID, assumed: the model records no loss of the picture during a raid.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }
  }

  chain Mission_Every_Air_Threat_Defeated_No_Leaker_Inside_2_km {
    type MISSION
    step Evaluate_The_Threat
    step Order_Engage
    step Order_Weapons_Free
    step Acquire_The_Target
    step Fire_The_Gun

    Evaluate_The_Threat -> Order_Engage : Threat_Judgement
    Order_Engage -> Order_Weapons_Free : Engage_Request
    Order_Weapons_Free -> Acquire_The_Target : Target_Named
    Acquire_The_Target -> Fire_The_Gun : Target_Locked

    moe Air_Raid_Defeated_Before_Reaching_The_Ship [DEFEATED_INSIDE_5_KM .. DEFEATED_BEYOND_5_KM] maximize {
      scale Raid_Outcome
      today LEAKER_INSIDE_2_KM
      formula LEVEL('Detect_To_Engage_Advice_Time_s')
      rationale MISSION. MoE for question OA: in the operating area -- the open sea, 150 contacts around the ship, and the busy strait, 1,000 contacts and raids of 30 minutes -- with the CMS deployed, how effectively is a raid defeated -- every air threat destroyed before it reaches the ship? It needs from the system Detect_To_Engage_Advice_Time_s [0 .. 10], Engage_Order_To_First_Round_Time_s [0 .. 30] -- what the market offers as an air surveillance radar with IFF, track management and threat evaluation (TEWA) software, a fire-control director, and a 76 mm gun with its fire control. Today: LEAKER_INSIDE_2_KM -- in the busy strait of the last exercise the advice came so late that a threat would have got inside 2 km.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }

  }

  chain Mission_No_Ship_Hit_Through_Equipment_Failure {
    type MISSION
    step Report_A_Defect
    step Send_The_Spare
    step Repair_At_Sea

    Report_A_Defect -> Send_The_Spare : Defect_Notice
    Send_The_Spare -> Repair_At_Sea : Spare_Part

    moe Ship_And_Escorted_Ships_Unharmed [NONE_HIT .. NONE_HIT] maximize {
      scale Ship_Protection
      today UNPROTECTED_HOURS
      formula LEVEL('Operational_Availability_At_Sea_Pct')
      rationale MISSION. MoE for question OA: in the operating area -- the open sea, 150 contacts around the ship, and the busy strait, 1,000 contacts and raids of 30 minutes -- with the CMS deployed, how effectively is the ship kept defended when its fighting equipment fails -- the ship and every ship it escorts come through without a hit? It needs from the system Operational_Availability_At_Sea_Pct [98 .. 100] -- what the market offers as built-in test, a spares package and a support contract. Today: UNPROTECTED_HOURS -- the ship has sailed with the plot equipment down for two days waiting for a spare.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }

  }

  chain Mission_Every_Threat_Warned_By_Allies_First {
    type MISSION
    step Share_A_Track
    step Take_The_Early_Warning

    Share_A_Track -> Take_The_Early_Warning : Allied_Track

    moe Threat_Seen_Before_It_Arrives [ALLIES_FIRST .. ALLIES_FIRST] maximize {
      scale Warning
      today OWN_SENSORS_FIRST
      formula LEVEL('Data_Link_Early_Warning_Time_s')
      rationale MISSION. MoE for question OA: in the operating area -- the open sea, 150 contacts around the ship, and the busy strait, 1,000 contacts and raids of 30 minutes -- with the CMS deployed, how effectively is the ship warned before a threat arrives -- an allied track on the picture before the ship's own sensors see it? It needs from the system Data_Link_Early_Warning_Time_s [60 .. 300] -- what the market offers as a Link 16 terminal and its gateway. Today: OWN_SENSORS_FIRST, assumed: the allied track is an early warning the ship does not yet use.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }
  }

  chain Mission_Fighting_System_Ready_Now_For_The_Next_Raid {
    type MISSION
    step Plan_The_Support
    step Maintain_The_Equipment
    step Train_The_Watch

    Plan_The_Support -> Maintain_The_Equipment : Support_Plan
    Maintain_The_Equipment -> Train_The_Watch : Ready_Equipment

    moe Fighting_System_Ready_For_The_Next_Raid [READY_NOW .. READY_NOW] maximize {
      scale Raid_Readiness
      today NOT_READY
      formula LEVEL('Combat_System_MTBF_h')
      rationale MISSION. MoE for question OA: in the operating area -- the open sea, 150 contacts around the ship, and the busy strait, 1,000 contacts and raids of 30 minutes -- with the CMS deployed, how effectively is the fighting system kept ready between raids -- supported, maintained and its watch trained -- so it is ready for the next raid now? It needs from the system Combat_System_MTBF_h [2000 .. 20000] -- what the market offers as combat-system hardware of proven reliability. Today: NOT_READY -- a spare once took two days to reach the ship.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }

  }

  chain Mission_No_Civil_Or_Friendly_Contact_Engaged {
    type MISSION
    step Broadcast_Identity
    step Identify_The_Contact
    step Confirm_The_Identity

    Broadcast_Identity -> Identify_The_Contact : Identity_Broadcast
    Identify_The_Contact -> Confirm_The_Identity : Proposed_Identity

    moe Only_Hostile_Contacts_Engaged [NO_ERROR .. NO_ERROR] maximize {
      scale Engagement_Errors
      today WRONG_TRACK_ORDERED
      formula LEVEL('Contacts_Held_True_And_Identified_Pct')
      rationale MISSION. MoE for question OA: in the operating area -- the open sea, 150 contacts around the ship, and the busy strait, 1,000 contacts and raids of 30 minutes -- with the CMS deployed, how effectively are contacts identified -- only hostiles fired at, no civil or friendly contact engaged? It needs from the system Contacts_Held_True_And_Identified_Pct [92 .. 100] -- what the market offers as IFF, AIS and ADS-B receivers, an EO director and identity fusion software. Today: WRONG_TRACK_ORDERED -- in the busy strait the picture held only most of the contacts true, and an order went to a wrong track.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }

  }
}

layer SA {

  system {
    function Sense_Air_Contacts {
      realizes Watch_The_Air
      scan_s = 1.0
    }

    function Challenge_Contacts {
      realizes Identify_The_Contact
    }

    function Sense_Surface_And_Drones {
      realizes Watch_The_Air
    }

    function Watch_Contacts_Visually {
      realizes Watch_The_Air
    }

    function Locate_Emitters {
      realizes Identify_The_Contact
    }

    function Receive_Identity_Broadcasts {
      realizes Identify_The_Contact
    }

    function Know_Own_Ship_State {
      realizes Plot_The_Track
    }

    function Build_Tracks {
      realizes Plot_The_Track
      confirm_scans = 3
      cycle_s = 1.0
      held_share = 0.98
      current_s = 2.0
      track_capacity = 600
    }

    function Identify_Tracks {
      realizes Identify_The_Contact
      id_s = 2.0
      coop_share = 0.85
      coop_accuracy = 0.998
      noncoop_accuracy = 0.85
    }

    function Evaluate_Threats {
      realizes Evaluate_The_Threat
      tewa_s = 1.0
    }

    function Advise_The_Officers {
      realizes Evaluate_The_Threat
      display_s = 0.5
    }

    function Hold_For_Weapons_Free {
      realizes Order_Weapons_Free
    }

    function Designate_And_Track_Target {
      realizes Acquire_The_Target
      designation_s = 2.0
      lock_s = 4.0
    }

    function Compute_Fire_Solution {
      realizes Fire_The_Gun
      solution_s = 2.0
    }

    function Engage_The_Target {
      realizes Fire_The_Gun
      engage_s = 3.0
    }

    function Engage_Close_In {
      realizes Fire_Close_In
    }

    function Detect_Picture_Loss {
      realizes Lose_The_Plot
    }

    function Restore_Picture {
      realizes Restore_The_Plot
      failover_s = 2.0
      fail_share = 0.02
    }

    function Receive_Allied_Tracks {
      realizes Take_The_Early_Warning
      link_track_km = 60.0
    }

    function Exchange_Fleet_Picture {
      realizes Take_The_Early_Warning
    }

    function Report_Defects {
      realizes Report_A_Defect
      system_mtbf_h = 5000.0
    }

    function Restore_Readiness {
      realizes Repair_At_Sea
    }

    function Report_Readiness {
      realizes Maintain_The_Equipment
      support_mthb = 9.0
      hardware_mthb = 12.0
      spares_mthb = 3.0
    }

    function Run_Training_Exercise {
      realizes Train_The_Watch
      training_mthb = 4.0
    }
  }

  entity Air_Threat non_human {
    function Fly_At_The_Ship {
      realizes Fly_At_The_Ship
    }
  }

  entity Civil_Traffic non_human {
    function Broadcast_Identity {
      realizes Broadcast_Identity
    }

    function Answer_Interrogation {
      realizes Broadcast_Identity
    }
  }

  entity Allied_Unit non_human {
    function Share_A_Track {
      realizes Share_A_Track
    }
  }

  entity Fleet_Command_System non_human {
    function Share_Fleet_Picture {
      realizes Pass_The_Fleet_Picture
    }
  }

  entity Fleet_Support non_human {
    function Send_Spare {
      realizes Send_The_Spare
      logistics_h = 48.0
    }

    function Plan_Support {
      realizes Plan_The_Support
    }
  }

  entity Readiness_ERP non_human {
    function Record_Readiness {
      realizes Plan_The_Support
    }
  }

  entity Tactical_Action_Officer human {
    function Order_Engage {
      realizes Order_Engage
      decision_s = 10.0
    }

    function Confirm_Identity {
      realizes Confirm_The_Identity
    }
  }

  entity Commanding_Officer human {
    function Order_Weapons_Free {
      realizes Order_Weapons_Free
      decision_s = 8.0
    }
  }

  entity Ship_Technicians non_human {
    function Repair_Equipment {
      realizes Repair_At_Sea
      mttr_h = 2.0
    }

    function Maintain_Equipment {
      realizes Maintain_The_Equipment
    }
  }

  communication Air_Threat -> System {
    interface Threat_Signatures {
      flow Reflected_Signal
      flow Heat_Radiation
      flow Seeker_Radar_Emission
      flow Low_Level_Echo
    }
  }

  communication Civil_Traffic -> System {
    interface Identity_Signals {
      data AIS_And_ADS_B_Message
      data Identity_Reply_Code
    }
  }

  communication Allied_Unit -> System {
    interface Data_Link_In {
      data Allied_Track_Data
    }
  }

  communication Fleet_Command_System -> System {
    interface Fleet_Picture_In {
      data Fleet_Track_Data
    }
  }

  communication Ship_Technicians -> System {
    interface Maintenance_Entry {
      data Repair_Record
      data Maintenance_Log
    }
  }

  communication Tactical_Action_Officer -> System {
    interface Officer_Orders {
      event Engage_E
      data Identity_Decision
    }
  }

  communication Commanding_Officer -> System {
    interface Command_Authority {
      event Weapons_Free_F
    }
  }

  communication System -> Air_Threat {
    interface Fire_Effects {
      flow Engagement_Rounds
      flow Close_In_Rounds_And_Decoys
    }
  }

  communication System -> Civil_Traffic {
    interface Identity_Challenge_Signal {
      event Challenge_Message
    }
  }

  communication System -> Allied_Unit {
    interface Data_Link_Out {
      data Own_Track_Data
    }
  }

  communication System -> Fleet_Command_System {
    interface Fleet_Picture_Out {
      data Own_Picture_Data
    }
  }

  communication System -> Fleet_Support {
    interface Defect_Reporting {
      data Defect_Record
    }
  }

  communication System -> Readiness_ERP {
    interface Readiness_Reporting {
      data Readiness_Record
    }
  }

  communication System -> Tactical_Action_Officer {
    interface Officer_Displays {
      data Engagement_Advice
      data Identity_Proposal
    }
  }

  communication System -> Commanding_Officer {
    interface Command_Display {
      event Weapons_Free_Prompt
    }
  }

  Fly_At_The_Ship -> Watch_Contacts_Visually : Heat_Signature
  Fly_At_The_Ship -> Locate_Emitters : Seeker_Emission
  Fly_At_The_Ship -> Sense_Surface_And_Drones : Low_Echo
  Engage_The_Target -> Fly_At_The_Ship : Fire_At_Target
  Engage_Close_In -> Fly_At_The_Ship : Close_In_Fire
  Challenge_Contacts -> Answer_Interrogation : Identity_Challenge
  Answer_Interrogation -> Challenge_Contacts : Identity_Reply
  Challenge_Contacts -> Identify_Tracks : Identity_Reply_Report
  Locate_Emitters -> Identify_Tracks : Emitter_Report
  Watch_Contacts_Visually -> Identify_Tracks : Contact_Imagery
  Sense_Surface_And_Drones -> Build_Tracks : Surface_And_Drone_Plots
  Know_Own_Ship_State -> Build_Tracks : Own_Ship_Position
  Know_Own_Ship_State -> Compute_Fire_Solution : Own_Ship_Motion
  Build_Tracks -> Evaluate_Threats : Air_Picture
  Build_Tracks -> Identify_Tracks : Track_For_Identity
  Build_Tracks -> Detect_Picture_Loss : Picture_Heartbeat
  Build_Tracks -> Share_A_Track : Own_Track_Report
  Build_Tracks -> Exchange_Fleet_Picture : Picture_For_Fleet
  Exchange_Fleet_Picture -> Share_Fleet_Picture : Own_Picture_Share
  Share_Fleet_Picture -> Exchange_Fleet_Picture : Fleet_Picture
  Exchange_Fleet_Picture -> Build_Tracks : Fleet_Tracks
  Receive_Allied_Tracks -> Sense_Air_Contacts : Search_Cue
  Receive_Allied_Tracks -> Build_Tracks : Allied_Tracks
  Confirm_Identity -> Evaluate_Threats : Confirmed_Identity
  Restore_Picture -> Evaluate_Threats : Restored_Picture
  Engage_The_Target -> Evaluate_Threats : Weapon_Status
  Hold_For_Weapons_Free -> Engage_Close_In : Close_In_Released
  Report_Readiness -> Record_Readiness : Readiness_Status

  chain Time_Critical_Plot_To_Track {
    realizes Mission_Defended_Area_Clear_Of_Air_Threat_For_6_Hours
    type MISSION
    detect_km = 25.0
    speed_km_s = 0.25

    step Fly_At_The_Ship
    step Sense_Air_Contacts
    step Build_Tracks

    Fly_At_The_Ship -> Sense_Air_Contacts : Contact_Echo
    Sense_Air_Contacts -> Build_Tracks : Air_Plots

    mop Firm_Track_Initiation_Time_s [0 .. 4] minimize {
      formula round(PN('Build_Tracks','confirm_scans') * max(PN('Sense_Air_Contacts','scan_s'), PN('Build_Tracks','cycle_s')), 1)
      rationale TIME. MOP for question SA: the capability to turn a first plot into a firm track within 4 s -- confirmed over 3 revisits, each as long as the radar's revisit or the picture's update, whichever is slower. Bought or built as the sensors and the track fusion together; feeds Detect_To_Engage_Advice_Time_s, for Air_Raid_Defeated_Before_Reaching_The_Ship in OA. In the ConOps: fly at the ship, watch the air, plot the track. Offered as a 3D surveillance radar and a track management system.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator, Track_Supervisor
      consulted Ship_Technicians when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Small_Air_Target_Detection_Range_km [20 .. 100] maximize {
      formula PN('Time_Critical_Plot_To_Track','detect_km')
      refines Air_Threat_Gone_From_The_Defended_Area
      means CLEAR_FOR_6_H
      rationale TIME. MOP for question SA: the capability to plot a small air threat at least 20 km out -- the surveillance radar and its plot extraction, bought or built for Air_Threat_Gone_From_The_Defended_Area in OA, so no threat comes inside the defended area unseen. That is what CLEAR_FOR_6_H needs here. In the ConOps: fly at the ship, watch the air, plot the track. Offered as a 3D air surveillance radar.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator
      consulted Ship_Technicians when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Simultaneous_Track_Capacity [500 .. 2000] maximize {
      formula PN('Build_Tracks','track_capacity')
      refines Air_Threat_Gone_From_The_Defended_Area
      means CLEAR_FOR_6_H
      rationale QUALITY. MOP for question SA: the capability to hold at least 500 tracks in the picture at once -- the specification says 600 -- so no contact around the ship is dropped. Bought or built as the track fusion, for Air_Threat_Gone_From_The_Defended_Area in OA. That is what CLEAR_FOR_6_H needs here. In the ConOps: fly at the ship, watch the air, plot the track. Offered as a track management (multi-sensor fusion) system.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator, Track_Supervisor
      consulted Ship_Technicians when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Failure_Picture_Loss_To_Recovery {
    realizes Mission_Air_Picture_Never_Lost_During_A_Raid
    type MISSION

    step Detect_Picture_Loss
    step Restore_Picture

    Detect_Picture_Loss -> Restore_Picture : Picture_Lost

    mop Air_Picture_Recovery_Time_s [0 .. 3] minimize {
      formula PN('Restore_Picture','failover_s')
      refines Air_Picture_Held_Through_A_Raid
      means NEVER_LOST
      rationale TIME. MOP for question SA: the capability to restore the air picture within 3 s when a plot node is lost -- a standby node that takes over, bought or built for Air_Picture_Held_Through_A_Raid in OA. That is what NEVER_LOST needs here. In the ConOps: lose the plot, restore the plot. Offered as a combat-system server cluster with a hot standby.
      accountable Tactical_Action_Officer
      responsible Ship_Technicians, Track_Supervisor
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }

    mop Node_Failover_Added_Delay_s [0 .. 0.1] minimize {
      formula round(PN('Restore_Picture','fail_share') * PN('Restore_Picture','failover_s'), 2)
      rationale TIME. MOP for question SA: the capability to keep a lost node from slowing the reaction -- no more than 0.1 s added to a reaction, on average. Bought or built with the standby node; feeds Detect_To_Engage_Advice_Time_s, for Air_Raid_Defeated_Before_Reaching_The_Ship in OA. In the ConOps: lose the plot, restore the plot. Offered as a combat-system server cluster with a hot standby.
      accountable Commanding_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Watch_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Mission_Air_Defence_Engagement {
    realizes Mission_Every_Air_Threat_Defeated_No_Leaker_Inside_2_km
    type MISSION

    step Evaluate_Threats
    step Advise_The_Officers
    step Order_Engage
    step Hold_For_Weapons_Free
    step Order_Weapons_Free
    step Designate_And_Track_Target
    step Compute_Fire_Solution
    step Engage_The_Target

    Evaluate_Threats -> Advise_The_Officers : Threat_Ranking
    Advise_The_Officers -> Order_Engage : Engage_Advice {
      realizes Threat_Judgement
    }
    Order_Engage -> Hold_For_Weapons_Free : Engage_Order {
      realizes Engage_Request
    }
    Hold_For_Weapons_Free -> Order_Weapons_Free : Weapons_Free_Request
    Order_Weapons_Free -> Designate_And_Track_Target : Weapons_Free_Order {
      realizes Target_Named
    }
    Designate_And_Track_Target -> Compute_Fire_Solution : Fire_Control_Track {
      realizes Target_Locked
    }
    Compute_Fire_Solution -> Engage_The_Target : Fire_Order

    mop Detect_To_Engage_Advice_Time_s [0 .. 10] minimize {
      formula round(MOPV('Firm_Track_Initiation_Time_s') + PN('Identify_Tracks','id_s') + PN('Evaluate_Threats','tewa_s') + PN('Advise_The_Officers','display_s') + MOPV('Node_Failover_Added_Delay_s'), 1)
      refines Air_Raid_Defeated_Before_Reaching_The_Ship
      means DEFEATED_INSIDE_5_KM
      rationale TIME. MOP for question SA: the capability to put engagement advice on the officers' console within 10 s of a threat's first plot -- the track, its identity, the threat evaluation and the display together, bought or built for Air_Raid_Defeated_Before_Reaching_The_Ship in OA. That is what DEFEATED_INSIDE_5_KM needs here: the threat is then still 22.5 km out. In the ConOps: evaluate the threat, order engage, order weapons free, acquire the target, fire the gun. Offered as track management and threat evaluation (TEWA) software.
      accountable Commanding_Officer
      responsible Tactical_Action_Officer, Fire_Control_Operator
      consulted Training_Officer when BEFORE_CHANGE by MEETING
      informed Fleet_Command when ON_BREACH by MESSAGE
    }

    mop Engage_Order_To_First_Round_Time_s [0 .. 30] minimize {
      formula PN('Order_Engage','decision_s') + PN('Order_Weapons_Free','decision_s') + PN('Designate_And_Track_Target','designation_s') + PN('Designate_And_Track_Target','lock_s') + PN('Compute_Fire_Solution','solution_s') + PN('Engage_The_Target','engage_s')
      refines Air_Raid_Defeated_Before_Reaching_The_Ship
      means DEFEATED_INSIDE_5_KM
      rationale TIME. MOP for question SA: the capability to get the first round away within 30 s of the advice -- the two human orders, the designation, the lock, the fire solution and the engagement. Bought or built as the fire-control chain, for Air_Raid_Defeated_Before_Reaching_The_Ship in OA. That is what DEFEATED_INSIDE_5_KM needs here. In the ConOps: evaluate the threat, order engage, order weapons free, acquire the target, fire the gun. Offered as a fire-control director and a gun fire-control system.
      accountable Tactical_Action_Officer
      responsible Fire_Control_Operator, Gun_Crew, Close_In_Weapon_Crew
      consulted Training_Officer when BEFORE_CHANGE by MEETING
      informed Commanding_Officer when ON_BREACH by MESSAGE
    }
  }

  chain Problem_Equipment_Down {
    realizes Mission_No_Ship_Hit_Through_Equipment_Failure
    type MISSION

    step Report_Defects
    step Send_Spare
    step Repair_Equipment
    step Restore_Readiness

    Report_Defects -> Send_Spare : Defect_Report
    Send_Spare -> Repair_Equipment : Spare_Part
    Repair_Equipment -> Restore_Readiness : Repair_Done

    mop Operational_Availability_At_Sea_Pct [98 .. 100] maximize {
      formula round(100 * PN('Report_Defects','system_mtbf_h') / (PN('Report_Defects','system_mtbf_h') + PN('Repair_Equipment','mttr_h') + PN('Send_Spare','logistics_h')), 2)
      refines Ship_And_Escorted_Ships_Unharmed
      means NONE_HIT
      rationale QUALITY. MOP for question SA: the capability to be ready at least 98 % of the time at sea, the wait for a spare included -- the reliability, the repair and the spares, bought or built for Ship_And_Escorted_Ships_Unharmed in OA. That is what NONE_HIT needs here. In the ConOps: report a defect, send the spare, repair at sea. Offered as built-in test, a spares package and a support contract.
      accountable Commanding_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Fleet_Command when MONTHLY by REPORT
    }

    mop Combat_System_MTBF_h [2000 .. 20000] maximize {
      formula PN('Report_Defects','system_mtbf_h')
      refines Fighting_System_Ready_For_The_Next_Raid
      means READY_NOW
      rationale QUALITY. MOP for question SA: the capability to run at least 2,000 hours between failures -- the reliability bought or built into the fighting system, for Fighting_System_Ready_For_The_Next_Raid in OA. That is what READY_NOW needs here. In the ConOps: report a defect, send the spare, repair at sea. Offered as combat-system hardware of proven reliability.
      accountable Commanding_Officer
      responsible Ship_Technicians
      consulted Fleet_Support when BEFORE_CHANGE by REPORT
      informed Fleet_Command when MONTHLY by REPORT
    }
  }

  chain Opportunity_Data_Link_Cue {
    realizes Mission_Every_Threat_Warned_By_Allies_First
    type MISSION

    step Share_A_Track
    step Receive_Allied_Tracks

    Share_A_Track -> Receive_Allied_Tracks : Allied_Track_Message {
      latency_s = 6.0
    }

    mop Data_Link_Early_Warning_Time_s [60 .. 300] maximize {
      formula round((PN('Receive_Allied_Tracks','link_track_km') - PN('Time_Critical_Plot_To_Track','detect_km')) / PN('Time_Critical_Plot_To_Track','speed_km_s') - PN('Allied_Track_Message','latency_s') - PN('Build_Tracks','cycle_s'), 1)
      refines Threat_Seen_Before_It_Arrives
      means ALLIES_FIRST
      rationale TIME. MOP for question SA: the capability to put an allied track on the picture at least 60 s before the ship's own sensors see the threat -- the data link and its gateway, bought or built for Threat_Seen_Before_It_Arrives in OA. The track arrives 6 s old and shows at the picture's next update. That is what ALLIES_FIRST needs here. In the ConOps: share a track, take the early warning. Offered as a Link 16 terminal and its gateway.
      accountable Tactical_Action_Officer
      responsible Track_Supervisor, Allied_Unit
      consulted Fleet_Command when BEFORE_CHANGE by MEETING
      informed Watch_Officer when ON_CHANGE by DASHBOARD
    }
  }

  chain Cost_Critical_Ownership {
    realizes Mission_Fighting_System_Ready_Now_For_The_Next_Raid
    type MISSION

    step Plan_Support
    step Maintain_Equipment
    step Report_Readiness
    step Run_Training_Exercise

    Plan_Support -> Maintain_Equipment : Support_Plan
    Maintain_Equipment -> Report_Readiness : Maintenance_Record
    Report_Readiness -> Run_Training_Exercise : Readiness_Confirmed

    mop Support_Hardware_Spares_Cost_MTHB_Year [0 .. 25] minimize {
      formula PN('Report_Readiness','support_mthb') + PN('Report_Readiness','hardware_mthb') + PN('Report_Readiness','spares_mthb')
      rationale COST. MOP for question SA: what the capability bought or built costs a year in software support, hardware and spares -- no more than 25 MTHB. Feeds Ownership_Cost_MTHB_Year. In the ConOps: plan the support, maintain the equipment, train the watch. Offered as a support, hardware and spares contract.
      accountable Fleet_Support
      responsible Ship_Technicians
      consulted Commanding_Officer when BEFORE_CHANGE by REPORT
      informed Fleet_Command when MONTHLY by REPORT
    }

    mop Ownership_Cost_MTHB_Year [0 .. 35] minimize {
      formula round(MOPV('Support_Hardware_Spares_Cost_MTHB_Year') + PN('Run_Training_Exercise','training_mthb'), 2)
      rationale COST. MOP for question SA: what keeping the capability bought or built costs the navy a year -- support, hardware, spares and training -- no more than 35 MTHB. It satisfies no mission MoE in OA. In the ConOps: plan the support, maintain the equipment, train the watch. Offered as a through-life support and training contract.
      accountable Fleet_Support
      responsible Ship_Technicians
      consulted Commanding_Officer when BEFORE_CHANGE by MEETING
      informed Fleet_Command when MONTHLY by REPORT
    }
  }

  chain Quality_Critical_Air_Picture_Truth {
    realizes Mission_No_Civil_Or_Friendly_Contact_Engaged
    type MISSION

    step Broadcast_Identity
    step Receive_Identity_Broadcasts
    step Identify_Tracks
    step Confirm_Identity

    Broadcast_Identity -> Receive_Identity_Broadcasts : Identity_Broadcast
    Receive_Identity_Broadcasts -> Identify_Tracks : Identity_Reports
    Identify_Tracks -> Confirm_Identity : Proposed_Identity

    mop Contacts_Held_True_And_Identified_Pct [92 .. 100] maximize {
      formula round(100 * PN('Build_Tracks','held_share') * (PN('Identify_Tracks','coop_share') * PN('Identify_Tracks','coop_accuracy') + (1 - PN('Identify_Tracks','coop_share')) * PN('Identify_Tracks','noncoop_accuracy')) * min(1, PN('Build_Tracks','current_s') / max(PN('Sense_Air_Contacts','scan_s'), PN('Build_Tracks','cycle_s'))), 1)
      refines Only_Hostile_Contacts_Engaged
      means NO_ERROR
      rationale QUALITY. MOP for question SA: the capability to hold at least 92 % of the contacts around the ship as tracks that are current and correctly identified -- the sensors, the identity fusion and the track management, bought or built for Only_Hostile_Contacts_Engaged in OA. That is what NO_ERROR needs here. In the ConOps: broadcast identity, identify the contact, confirm the identity. Offered as IFF, AIS and ADS-B receivers, an EO director and identity fusion software.
      accountable Tactical_Action_Officer
      responsible Air_Picture_Operator, Track_Supervisor
      consulted Allied_Unit when BEFORE_CHANGE by REPORT
      informed Watch_Officer when ON_CHANGE by DASHBOARD
    }
  }

  decision Build_Tracks {
    option Slower_Picture_Update {
      Build_Tracks.cycle_s = 2.5
    }
  }
}

layer LA {

  system {
    component Sensor_Integration {
      component Air_Surveillance {
        principle search the whole sky every second and ask every contact who it is
        technique a revisit a second, and a challenge each contact must answer
        discipline RADAR_ENGINEERING, SIGNAL_PROCESSING
        function Detect_Air_Contacts {
          realizes Sense_Air_Contacts
          revisits_per_min = 60.0
          technique scan_s {
            formula 60 / revisits_per_min
            rationale revisit time, T = 60 / revisits a minute: how long between two looks at the same contact
          }
        }

        function Interrogate_Contacts {
          realizes Challenge_Contacts
          reply_chance = 0.9
          challenges = 2.0
          technique reply_share {
            formula 1 - (1 - reply_chance)^challenges
            rationale binomial chance, P = 1 - (1 - p)^n: a friendly contact answers at least one of n challenges
          }
        }
      }

      component Surface_Surveillance {
        principle see every surface contact out to the horizon
        technique the radio horizon from the antenna's height and the target's
        discipline RADAR_ENGINEERING
        function Detect_Surface_Contacts {
          realizes Sense_Surface_And_Drones
          antenna_height_m = 25.0
          target_height_m = 10.0
          technique horizon_km {
            formula 4.12 * (sqrt(antenna_height_m) + sqrt(target_height_m))
            rationale radio horizon over a 4/3 earth, d = 4.12 (sqrt(h1) + sqrt(h2)) km: a surface contact is seen no further
          }
        }
      }

      component Drone_Surveillance {
        principle look for the small, slow and low contacts the main search misses
        technique detection range scaled by the fourth root of the echo area
        discipline RADAR_ENGINEERING, ELECTRO_OPTICS
        function Detect_Small_Drones {
          realizes Sense_Surface_And_Drones
          reference_range_km = 20.0
          drone_rcs_m2 = 0.01
          reference_rcs_m2 = 1.0
          technique drone_range_km {
            formula reference_range_km * (drone_rcs_m2 / reference_rcs_m2)^0.25
            rationale radar range equation, R proportional to the fourth root of the echo area: a small drone is seen much closer
          }
        }
      }

      component Underwater_Surveillance {
        principle listen and ping below the surface
        technique the sonar's figure of merit spent on spherical spreading
        discipline UNDERWATER_ACOUSTICS
        function Detect_Underwater_Contacts {
          realizes Sense_Surface_And_Drones
          figure_of_merit_db = 80.0
          technique detection_range_m {
            formula 10^(figure_of_merit_db / 20)
            rationale spherical spreading, TL = 20 log10 r: the range at which the loss uses up the figure of merit
          }
        }
      }

      component Visual_Surveillance {
        principle see a contact in daylight and darkness and name it by its shape
        technique identification range by the Johnson criteria
        discipline ELECTRO_OPTICS
        function Observe_Contact_Visually {
          realizes Watch_Contacts_Visually
          target_size_m = 5.0
          cycles_needed = 6.0
          resolution_mrad = 0.1
          technique identify_range_m {
            formula target_size_m / (cycles_needed * resolution_mrad / 1000)
            rationale Johnson criteria: a contact is identified once it spans n resolvable cycles
          }
        }
      }

      component Fire_Control_Sensing {
        principle hold one target in a narrow beam for the weapons
        technique slew then settle onto the designation, and track by monopulse
        discipline RADAR_ENGINEERING, CONTROL_ENGINEERING
        function Lock_And_Track_Target {
          realizes Designate_And_Track_Target
          slew_deg = 90.0
          slew_dps = 30.0
          settle_s = 1.0
          technique lock_s {
            formula slew_deg / slew_dps + settle_s
            rationale slew then settle, t = angle / rate + settling time
          }
        }
      }

      component Electronic_Support {
        principle hear every emitter and locate it, sending nothing
        technique intercept by dwelling on each band, and geolocation by time difference
        discipline ELECTRONIC_WARFARE, SIGNAL_PROCESSING
        function Intercept_Emitters {
          realizes Locate_Emitters
          looks = 10.0
          dwell_share = 0.2
          technique intercept_share {
            formula 1 - exp(-looks * dwell_share)
            rationale Poisson coverage, P = 1 - e^(-n d): the receiver dwells on the emitter's band often enough to catch it
          }
        }
      }

      component Identity_Reception {
        principle take every identity a contact announces of itself
        technique repeated broadcasts, one heard of several
        discipline COMMUNICATIONS_ENGINEERING
        function Receive_Identity_Messages {
          realizes Receive_Identity_Broadcasts
          message_chance = 0.95
          repeats = 3.0
          technique message_share {
            formula 1 - (1 - message_chance)^repeats
            rationale binomial chance, P = 1 - (1 - p)^n: an identity broadcast heard on at least one of n repeats
          }
        }
      }

      component Own_Ship_Sensing {
        principle know where the ship is, how it moves and the weather around it
        technique satellite fixes, with dead reckoning between them
        discipline NAVIGATION
        function Measure_Own_Ship_State {
          realizes Know_Own_Ship_State
          drift_m_per_h = 30.0
          hours_since_fix = 0.5
          technique position_error_m {
            formula drift_m_per_h * hours_since_fix
            rationale dead-reckoning drift, e = drift rate x time since the last fix
          }
        }
      }

      component Sensor_Data_Integration {
        principle turn every sensor's report into one language, and point the sensors where they are needed
        technique one adapter for each sensor family, cueing in turn
        discipline SOFTWARE_ENGINEERING, SYSTEMS_INTEGRATION
        function Ingest_Sensor_Reports {
          realizes Build_Tracks
          reports_per_cycle = 100.0
          ms_per_report = 5.0
          technique ingest_s {
            formula reports_per_cycle * ms_per_report / 1000
            rationale linear processing time, t = n x t1: every report of the cycle decoded into one language
          }
        }

        function Cue_Sensors {
          realizes Receive_Allied_Tracks
          sensors_cued = 3.0
          ms_per_cue = 200.0
          technique cue_s {
            formula sensors_cued * ms_per_cue / 1000
            rationale serial cueing, t = n x t1: each sensor pointed in turn
          }
        }
      }
    }

    component Data_Fusion {
      component Track_Management {
        principle one track for each object, confirmed before anyone acts on it
        technique track confirmation on n looks, each as slow as the slower of the sensor and the fusion cycle
        discipline DATA_FUSION, ESTIMATION_THEORY
        function Fuse_Tracks {
          realizes Build_Tracks
          confirm_scans = 3
          cycle_s = 1.0
          track_capacity = 1000
          held_share = 0.98
          current_s = 2.0
          fusion_nodes = 2
          technique initiation_s {
            formula TECH('Ingest_Sensor_Reports') + confirm_scans * max(TECH('Detect_Air_Contacts'), cycle_s)
            rationale track confirmation, t = t_ingest + n x max(T_revisit, T_cycle): n looks, each as slow as the slower of the sensor and the fusion cycle
          }
        }
      }

      component Identification {
        principle name every contact, by its own reply where it gives one and by the evidence where it does not
        technique joint probability for the cooperative, independent evidence for the silent
        discipline DATA_FUSION, MACHINE_LEARNING
        function Fuse_Identity {
          realizes Identify_Tracks
          id_s = 2.0
          coop_share = 0.85
          coop_accuracy = 0.998
          technique coop_correct_share {
            formula coop_share * coop_accuracy
            rationale joint probability, P = P(answers) x P(right | answers): the contacts identified right by their own reply
          }
        }

        function Classify_Non_Cooperative {
          realizes Identify_Tracks
          kinematic_accuracy = 0.8
          emitter_accuracy = 0.3
          technique noncoop_accuracy {
            formula 1 - (1 - kinematic_accuracy) * (1 - emitter_accuracy)
            rationale independent evidence, P = 1 - (1 - p1)(1 - p2): a silent contact classed right by its motion or by its emitter
          }
        }
      }
    }

    component Combat_Systems {
      component Threat_Evaluation {
        principle rank every threat and propose a weapon for each; a person decides
        technique a doctrine-gated ranking over every weapon-target pair
        discipline OPERATIONS_RESEARCH
        function Rank_Threats {
          realizes Evaluate_Threats
          threats = 10.0
          ms_per_threat = 100.0
          technique tewa_s {
            formula threats * ms_per_threat / 1000
            rationale linear computing time, t = n x t1: each threat in the picture ranked against the doctrine
          }
        }

        function Propose_Weapon_Assignment {
          realizes Advise_The_Officers
          weapons = 5.0
          threats_ranked = 10.0
          technique pairings {
            formula weapons * threats_ranked
            rationale the assignment's search space, n = weapons x threats: every weapon-target pair weighed
          }
        }
      }

      component Fire_Control {
        principle aim where the target will be, and fire nothing until the interlock agrees
        technique designation by stages, fixed-point ballistics, serial interlock checks
        discipline BALLISTICS, CONTROL_ENGINEERING
        function Designate_Fire_Control_Sensor {
          realizes Designate_And_Track_Target
          handover_s = 0.5
          message_s = 1.0
          technique designation_s {
            formula handover_s + message_s
            rationale time budget by stages, t = t1 + t2: the track handed over, then the designation sent
          }
        }

        function Compute_Ballistics {
          realizes Compute_Fire_Solution
          iterations = 3.0
          iteration_s = 0.5
          technique solution_s {
            formula iterations * iteration_s
            rationale fixed-point iteration, t = n x t1: the time of flight and the lead worked out again until they agree
          }
        }

        function Release_Through_Interlock {
          realizes Compute_Fire_Solution
          checks = 5.0
          ms_per_check = 20.0
          technique interlock_s {
            formula checks * ms_per_check / 1000
            rationale serial checks, t = n x t1: every condition of the interlock confirmed before a round leaves
          }
        }

        function Order_Point_Defence {
          realizes Engage_Close_In
          inner_layer_km = 2.0
          threat_speed_km_s = 0.25
          technique time_to_go_s {
            formula inner_layer_km / threat_speed_km_s
            rationale time to go, t = d / v: what the inner layer has left
          }
        }
      }

      component Weapon_Control {
        principle lay the weapon on the computed aim and fire only on release
        technique slew-then-fire timing, and the kill of a burst of independent rounds
        discipline WEAPONS_ENGINEERING
        function Aim_And_Fire {
          realizes Engage_The_Target
          lay_deg = 90.0
          train_dps = 45.0
          fire_delay_s = 1.0
          technique engage_s {
            formula lay_deg / train_dps + fire_delay_s
            rationale slew then fire, t = angle / rate + firing delay
          }
        }

        function Fire_Point_Defence {
          realizes Engage_Close_In
          hit_chance = 0.1
          rounds = 20.0
          technique kill_share {
            formula 1 - (1 - hit_chance)^rounds
            rationale independent rounds, P = 1 - (1 - p)^n
          }
        }
      }
    }

    component HMI_And_Human_Factors {
      component Tactical_Display {
        principle show the officer the advice and the proposed identity in time to act
        technique a frame budget, and Hick's law for the choice
        discipline HUMAN_FACTORS, SOFTWARE_ENGINEERING
        function Show_Engage_Advice {
          realizes Advise_The_Officers
          render_ms = 200.0
          refresh_ms = 300.0
          technique display_s {
            formula (render_ms + refresh_ms) / 1000
            rationale frame budget, t = render time + the wait for the next refresh
          }
        }

        function Show_Proposed_Identity {
          realizes Identify_Tracks
          hick_s = 0.2
          choices = 3.0
          technique choose_s {
            formula hick_s * log2(choices + 1)
            rationale Hick's law, t = b log2(n + 1): the officer's time to choose between n identities
          }
        }
      }

      component Engagement_Authority {
        principle two people, in turn, before any weapon fires
        technique two keys, held no longer than a share of the time to go
        discipline HUMAN_FACTORS, SAFETY_ENGINEERING
        function Hold_For_Weapons_Free {
          realizes Hold_For_Weapons_Free
          time_to_go_s = 60.0
          hold_fraction = 0.5
          technique hold_limit_s {
            formula time_to_go_s * hold_fraction
            rationale a hold no longer than a share of the time to go: past it the engagement is reported, not dropped
          }
        }

        function Release_Engagement {
          realizes Hold_For_Weapons_Free
          keys = 2.0
          key_s = 0.25
          technique release_s {
            formula keys * key_s
            rationale two keys in turn, t = n x t1: Engage, then weapons free
          }
        }
      }

      component Shared_Picture_Display {
        principle one picture for every room, on charts
        technique symbol density, and chart tiles served in turn
        discipline HUMAN_FACTORS, GEOINFORMATICS
        function Show_Shared_Picture {
          realizes Advise_The_Officers
          screen_cm2 = 1200.0
          cm2_per_track = 4.0
          technique tracks_shown {
            formula screen_cm2 / cm2_per_track
            rationale display density, n = screen area / area per symbol
          }
        }

        function Serve_Charts {
          realizes Advise_The_Officers
          tiles = 50.0
          ms_per_tile = 20.0
          technique chart_load_s {
            formula tiles * ms_per_tile / 1000
            rationale linear load time, t = n x t1: the chart tiles of one view served in turn
          }
        }
      }

      component Operator_Assistance {
        principle explain the advice; never give an order
        technique an explanation short enough to read before acting
        discipline HUMAN_FACTORS, ARTIFICIAL_INTELLIGENCE
        function Explain_Advice {
          realizes Advise_The_Officers
          words = 30.0
          words_per_s = 4.0
          technique read_s {
            formula words / words_per_s
            rationale reading time, t = words / reading rate: the officer reads the explanation
          }
        }
      }
    }

    component Middleware_And_Networks {
      component Data_Distribution {
        principle publish every sample once, to every user, before its deadline
        technique publish and subscribe, its lateness from the latency's exponential tail
        discipline DISTRIBUTED_SYSTEMS
        function Monitor_Distribution {
          realizes Detect_Picture_Loss
          deadline_ms = 100.0
          mean_latency_ms = 10.0
          technique late_share {
            formula exp(-deadline_ms / mean_latency_ms)
            rationale exponential tail, P(late) = e^(-D / mean): the share of samples that miss their deadline
          }
        }
      }

      component Picture_Resilience {
        principle lose a node, keep the picture
        technique heartbeats, then a hot standby switched in
        discipline DISTRIBUTED_SYSTEMS, RELIABILITY_ENGINEERING
        function Watch_Node_Health {
          realizes Detect_Picture_Loss
          missed_heartbeats = 2.0
          heartbeat_s = 0.25
          technique node_loss_detect_s {
            formula missed_heartbeats * heartbeat_s
            rationale heartbeats missed, t = n x period: a node declared lost
          }
        }

        function Take_Over_Picture {
          realizes Restore_Picture
          fail_share = 0.02
          switch_s = 1.0
          technique failover_s {
            formula TECH('Watch_Node_Health') + switch_s
            rationale time budget by stages, t = t_detect + t_switch: the loss detected, then the hot standby switched in
          }
        }
      }

      component External_Links {
        principle share the picture with allies and the fleet, both ways
        technique relay geometry for the reach, track load for the rate
        discipline COMMUNICATIONS_ENGINEERING
        function Exchange_Allied_Tracks {
          realizes Receive_Allied_Tracks
          hops = 2.0
          km_per_hop = 30.0
          technique link_track_km {
            formula hops * km_per_hop
            rationale relay geometry, d = hops x line-of-sight hop: how far out an allied track reaches the ship
          }
        }

        function Bridge_Fleet_Picture {
          realizes Exchange_Fleet_Picture
          tracks_shared = 200.0
          kbits_per_track = 0.5
          technique fleet_kbps {
            formula tracks_shared * kbits_per_track
            rationale link load, r = tracks x bits per track update
          }
        }
      }

      component Video_Distribution {
        principle every camera to every screen that needs it
        technique network load as streams times rate
        discipline NETWORK_ENGINEERING
        function Distribute_Video {
          realizes Watch_Contacts_Visually
          streams = 4.0
          mbps_per_stream = 8.0
          technique video_mbps {
            formula streams * mbps_per_stream
            rationale network load, r = streams x rate per stream
          }
        }
      }
    }

    component Cyber_Security {
      component Security_Monitoring {
        principle see every intrusion, wherever it comes in
        technique several independent sensors
        discipline CYBER_SECURITY
        function Detect_Intrusion {
          realizes Detect_Picture_Loss
          sensor_chance = 0.7
          sensors = 3.0
          technique intrusion_detect_share {
            formula 1 - (1 - sensor_chance)^sensors
            rationale independent sensors, P = 1 - (1 - p)^n: an intrusion seen by at least one
          }
        }
      }

      component Access_Control {
        principle every action by a known role, every action recorded
        technique role, session and audit checked in turn
        discipline CYBER_SECURITY
        function Check_Role_Authority {
          realizes Hold_For_Weapons_Free
          checks = 3.0
          ms_per_check = 10.0
          technique authority_s {
            formula checks * ms_per_check / 1000
            rationale serial checks, t = n x t1: the role, the session and the audit checked in turn
          }
        }
      }
    }

    component Test_Recording_And_ILS {
      component Built_In_Test {
        principle find every fault and say what being ready costs
        technique independent hardware and software tests, and a cost roll-up
        discipline RELIABILITY_ENGINEERING, INTEGRATED_LOGISTIC_SUPPORT
        function Detect_Defects {
          realizes Report_Defects
          other_mtbf_h = 6000.0
          fusion_mtbf_h = 4000.0
          hw_coverage = 0.9
          sw_coverage = 0.5
          technique fault_coverage {
            formula 1 - (1 - hw_coverage) * (1 - sw_coverage)
            rationale independent tests, P = 1 - (1 - p1)(1 - p2): a fault caught by the hardware test or the software test
          }
        }

        function Confirm_Repair {
          realizes Restore_Readiness
          tests = 20.0
          s_per_test = 3.0
          technique retest_s {
            formula tests * s_per_test
            rationale serial tests, t = n x t1: every test of the repaired unit run again
          }
        }

        function Report_Readiness {
          realizes Report_Readiness
          support_mthb = 9.0
          hardware_mthb = 12.0
          spares_mthb = 3.0
          technique equipment_mthb {
            formula support_mthb + hardware_mthb + spares_mthb
            rationale cost roll-up, C = support + hardware + spares, a year
          }
        }
      }

      component Recording_And_Replay {
        principle keep everything, to train on and to learn from
        technique courses a year at a cost a course
        discipline TRAINING
        function Record_And_Replay {
          realizes Run_Training_Exercise
          courses_per_year = 8.0
          course_mthb = 0.5
          technique training_mthb {
            formula courses_per_year * course_mthb
            rationale cost a year, C = courses x cost a course
          }
        }
      }
    }
  }

